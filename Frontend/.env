# ============================================
# CENTRALIZED VM IP CONFIGURATION
# ============================================
# Change this ONE variable to update all VM-related URLs
VITE_VM_HOST=192.168.91.129

# ============================================
# API ENDPOINTS
# ============================================
# Cloud-hosted backends (no changes needed)
VITE_API_URL=https://backend-ed29.onrender.com/api
VITE_BACKEND_URL=https://backend-1-v77y.onrender.com/api

# VM-hosted scan APIs (automatically use VITE_VM_HOST)
# Note: Vite doesn't support variable interpolation in .env files
# So we need to use a config file approach (see below)
VITE_SCAN_API_URL=http://${VITE_VM_HOST}:8000
VITE_SYSTEM_SCAN_API_URL=http://${VITE_VM_HOST}:9000

# ============================================
# APPLICATION CONFIGURATION
# ============================================
VITE_APP_NAME=XEncrypt Dashboard
VITE_ORG_NAME=Your Organization

# ============================================
# FEATURE FLAGS
# ============================================
VITE_ENABLE_WEBSCAN=true
VITE_ENABLE_INTEGRATIONS=true
