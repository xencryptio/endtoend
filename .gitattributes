# Force LF line endings (Linux-compatible)
* text=auto eol=lf

# Common file types that must have LF only
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
Dockerfile text eol=lf
.env text eol=lf
